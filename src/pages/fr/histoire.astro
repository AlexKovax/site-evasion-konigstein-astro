---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI, type Locale } from '../../consts';
import { getPostsByLocale, postUrl } from '../../lib/posts';

const locale: Locale = 'fr';
const t = UI[locale];
const posts = await getPostsByLocale(locale);

function fmtDate(d: Date) {
  return d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<BaseLayout locale={locale} title={t.navStory} path={Astro.url.pathname}>
  <section class="container" style="padding-top: 3rem;">
    <h1 style="font-family: var(--font-ui); font-weight: 700; font-size: 2.5rem; margin: 0 0 0.5rem;">{t.navStory}</h1>
    <p style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">{t.tagline}</p>
    <ol class="toc">
      {posts.map((post) => (
        <li>
          <span class="num">{post.data.chapter ?? '★'}</span>
          <a href={postUrl(post, locale)}>{post.data.title.replace(/^\d+\.\s*/, '')}</a>
          <span class="date">{fmtDate(post.data.pubDatetime)}</span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
