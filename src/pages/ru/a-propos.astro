---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI, SITE_INTRO, type Locale } from '../../consts';

const locale: Locale = 'ru';
const t = UI[locale];
---
<BaseLayout locale={locale} title={t.navAbout} path={Astro.url.pathname} noindex>
  <section class="container" style="padding-top: 3rem;">
    <h1 style="font-family: var(--font-ui); font-weight: 700; font-size: 2.5rem; margin: 0 0 1.5rem;">{t.navAbout}</h1>

    <aside class="intro-box">
      <p>{SITE_INTRO[locale]}</p>
    </aside>

    <p class="about-pending">{t.aboutPending}</p>
  </section>
</BaseLayout>
