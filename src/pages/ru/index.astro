---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI, COVER_IMAGE, SITE_INTRO, type Locale } from '../../consts';
import { getPostsByLocale } from '../../lib/posts';

const locale: Locale = 'ru';
const t = UI[locale];
const posts = await getPostsByLocale(locale);
---
<BaseLayout locale={locale} path={Astro.url.pathname} noindex={posts.length === 0}>
  <section class="hero">
    <img src={COVER_IMAGE} alt={t.siteName} loading="eager" />
    <div class="hero-content">
      <h1>{t.siteName}</h1>
      <p>{t.tagline}</p>
    </div>
  </section>

  <section class="container-wide" style="padding-top: 3rem;">
    <aside class="intro-editorial">
      <p set:html={SITE_INTRO[locale].replace(/^(\S)/, '<span class="drop-cap">$1</span>')} />
    </aside>
  </section>

  {posts.length === 0 ? (
    <div class="translation-pending">{t.translationPending}</div>
  ) : (
    <section class="container-wide">
      <ol class="toc">
        {posts.map((post) => (
          <li>
            <span class="num">{post.data.chapter ?? '★'}</span>
            <a href={`/${locale}/posts/${post.data.slug}/`}>{post.data.title}</a>
          </li>
        ))}
      </ol>
    </section>
  )}
</BaseLayout>
