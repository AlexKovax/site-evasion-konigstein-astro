---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI, type Locale } from '../../consts';
import { getPostsByLocale } from '../../lib/posts';

const locale: Locale = 'ru';
const t = UI[locale];
const posts = await getPostsByLocale(locale);
---
<BaseLayout locale={locale} title={t.navStory} path={Astro.url.pathname}>
  {posts.length === 0 ? (
    <div class="translation-pending">{t.translationPending}</div>
  ) : (
    <section class="container" style="padding-top: 3rem;">
      <ol class="toc">
        {posts.map((post) => (
          <li>
            <span class="num">{post.data.chapter ?? '★'}</span>
            <a href={`/${locale}/posts/${post.data.slug}/`}>{post.data.title}</a>
          </li>
        ))}
      </ol>
    </section>
  )}
</BaseLayout>
