---
import '@fontsource/fira-sans/400.css';
import '@fontsource/fira-sans/500.css';
import '@fontsource/fira-sans/700.css';
import '@fontsource/cardo/400.css';
import '@fontsource/cardo/400-italic.css';
import '@fontsource/cardo/700.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/cyrillic-400.css';
import '@fontsource/lora/cyrillic-400-italic.css';
import '@fontsource/lora/cyrillic-500.css';
import '@fontsource/fira-sans/cyrillic-400.css';
import '@fontsource/fira-sans/cyrillic-500.css';
import '@fontsource/fira-sans/cyrillic-700.css';

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI, type Locale } from '../consts';
import { getPostsByLocale } from '../lib/posts';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
}
const { locale, title, description, path = Astro.url.pathname } = Astro.props;
const t = UI[locale];
const pageTitle = title ? `${title} — ${t.siteName}` : t.siteName;
const pageDescription = description || t.tagline;
const canonical = new URL(path, Astro.site).href;

// On n'émet d'hreflang alternatif que si la traduction existe.
const otherLocale: Locale = locale === 'fr' ? 'ru' : 'fr';
const otherPosts = await getPostsByLocale(otherLocale);
const altHref = new URL(path.replace(`/${locale}/`, `/${otherLocale}/`), Astro.site).href;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    {otherPosts.length > 0 && (
      <link rel="alternate" hreflang={otherLocale} href={altHref} />
    )}
    {otherPosts.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={new URL('/fr/', Astro.site).href} />
    )}
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
